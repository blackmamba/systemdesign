    },
    {
      "id": "Za5hEz14vtJxYX2kJcQJ7",
      "type": "text",
      "x": 107.98291015625,
      "y": 656.2890625,
      "width": 631.9400634765625,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1509929810,
      "version": 72,
      "versionNonce": 768090962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786137036709,
      "link": null,
      "locked": false,
      "text": "// Config service. Acts as abstraction layer around the\ndatabase\nDashboardModel = {queries: SQLText[], visualizations: ...}\nDashboardModel GetDashboard(dashboardId)\n\n// Query service. Used to fetch data, with freshness semantics\n// Sync API below but you can propose an async implementation\n// mostAcceptableStaleData semantics are:\n// 1. If undefined, always OK to return stale data for the same\nSQL text\n// 2. If defined, only can return stale data that is no more\nstale than the timestamp\nData ExecuteQuery(query: SQLText, mostAcceptableStaleData?:\nTimestamp)\n\n// PDF snapshot service API\n// Loads a page and takes PDF snapshot. For dashboard URLs,\nyou can assume this component is smart enough to know when\nthe page has fully loaded.\nLinkToPDF Snapshot(url: String)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "x4AhsRTqNDexT5cpv71bL",
      "originalText": "// Config service. Acts as abstraction layer around the database\nDashboardModel = {queries: SQLText[], visualizations: ...}\nDashboardModel GetDashboard(dashboardId)\n\n// Query service. Used to fetch data, with freshness semantics\n// Sync API below but you can propose an async implementation\n// mostAcceptableStaleData semantics are:\n// 1. If undefined, always OK to return stale data for the same SQL text\n// 2. If defined, only can return stale data that is no more stale than the timestamp\nData ExecuteQuery(query: SQLText, mostAcceptableStaleData?: Timestamp)\n\n// PDF snapshot service API\n// Loads a page and takes PDF snapshot. For dashboard URLs, you can assume this component is smart enough to know when the page has fully loaded.\nLinkToPDF Snapshot(url: String)",
      "autoResize": true,
      "lineHeight": 1.25
    },
