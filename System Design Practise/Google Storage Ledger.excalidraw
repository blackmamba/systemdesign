    {
      "id": "WFqq0JLewXvQbB8HB3LWX",
      "type": "text",
      "x": -263.96484375,
      "y": 359.921875,
      "width": 800,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2D",
      "roundness": null,
      "seed": 2073088531,
      "version": 82,
      "versionNonce": 735089299,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793839477924,
      "created": 1793839470118,
      "link": null,
      "locked": false,
      "text": "Google One (G1) is a paid-subscription service with the original anchor in\nStorage. The way storage accounting works in Google is that each individual user\nstarts with a default 15GB of storage and usages across all Google products\n(Gmail, Drive, Photos, Backups) count against this quota. If a user goes above\nthe quota, they experience service degradation across Google surfaces, like their\nGoogle Drive going into a read-only mode, Gmail stops delivering emails, etc. The\nway a user recovers from this state is by either purchasing additional storage\n(from G1) or deleting existing data.\n\nThe goal is to design a system which can do storage accounting (available quota\nand usage) for all Google users.\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Google One (G1) is a paid-subscription service with the original anchor in Storage. The way storage accounting works in Google is that each individual user starts with a default 15GB of storage and usages across all Google products (Gmail, Drive, Photos, Backups) count against this quota. If a user goes above the quota, they experience service degradation across Google surfaces, like their Google Drive going into a read-only mode, Gmail stops delivering emails, etc. The way a user recovers from this state is by either purchasing additional storage (from G1) or deleting existing data.\n\nThe goal is to design a system which can do storage accounting (available quota and usage) for all Google users.\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    }
  ],
